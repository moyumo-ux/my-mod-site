{{ define "main" }}
<!DOCTYPE html>
<html lang="zh-cn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .Site.Title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/my-mod-site/css/base.css">
    <link rel="stylesheet" href="/my-mod-site/css/loading.css">
    <link rel="stylesheet" href="/my-mod-site/css/header.css">
    <link rel="stylesheet" href="/my-mod-site/css/spectrum.css">
    <link rel="stylesheet" href="/my-mod-site/css/doc-line.css">
    <link rel="stylesheet" href="/my-mod-site/css/main.css">
    <link rel="stylesheet" href="/my-mod-site/css/mod-cards.css">
    <link rel="stylesheet" href="/my-mod-site/css/titlebar.css">
</head>
<body>
    {{ partial "loading.html" . }}
    {{ partial "header.html" . }}
    {{ partial "spectrum.html" . }}
    {{ partial "bottom.html" . }}
    {{ partial "main-content.html" . }}
    <script src="/my-mod-site/js/loading.js"></script>
    <script src="/my-mod-site/js/mod-cards.js"></script>
</body>
</html>
{{ end }}